TARGET_ENV=Dev

# Chave da API do Gemini (Google AI Studio: https://aistudio.google.com/apikey)
# usada na moderação/classificação automática de avaliações via IA.
# NUNCA commitar a chave real! Preencha apenas no projeto.env local.
GEMINI_API_KEY=

# Chave da criptografia simétrica (Fernet/AES) que cifra em repouso os dados
# pessoais das reservas. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NUNCA commitar a chave real! Se esta chave for perdida, os dados cifrados
# tornam-se irrecuperáveis; se vazar, a criptografia perde o efeito.
FIELD_ENCRYPTION_KEY=
