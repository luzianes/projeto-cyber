# Copie este arquivo para "projeto.env" (na raiz do repositório) e preencha
# com valores locais. NUNCA commitar o projeto.env real -- ele já está no
# .gitignore.

TARGET_ENV=Dev
DEBUG=1
SECRET_KEY=troque-por-uma-chave-aleatoria-local
ALLOWED_HOSTS=127.0.0.1 localhost

# Postgres local via docker-compose.yml (deixe USE_POSTGRES=0 para usar
# SQLite em vez disso).
USE_POSTGRES=1
DBNAME=aponte_cafes_dev
DBHOST=localhost
DBPORT=5432
DBUSER=aponte_user
DBPASS=aponte_password
DBSSLMODE=disable

# E-mail (opcional em dev; necessário para o fluxo de "esqueci minha senha").
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=

# Chave da API do Gemini (Google AI Studio: https://aistudio.google.com/apikey)
# -- usada na moderação/classificação automática de avaliações por IA.
GEMINI_API_KEY=

# Chave da criptografia simétrica (Fernet) que cifra em repouso os dados
# pessoais das reservas. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Se perdida, os dados já cifrados com ela tornam-se irrecuperáveis.
FIELD_ENCRYPTION_KEY=

# --- Somente para TARGET_ENV=prod ---
# CSRF_TRUSTED_ORIGINS=https://seu-dominio.com
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=31536000
